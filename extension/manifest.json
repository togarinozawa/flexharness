{
  "manifest_version": 3,
  "name": "FlexHarness",
  "version": "0.2.1",
  "description": "見ているページをFlexHarness本体に伝えて、本体の判定どおりに止める。判定はここではしない。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.nicovideo.jp/*"],
      "js": ["veil.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "FlexHarness",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
